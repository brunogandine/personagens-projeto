generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model Anime {
  id            Int                @id @default(autoincrement()) @db.UnsignedInt
  active        Boolean            @default(false)
  name          String             @db.VarChar(255)
  description   String?            @db.Text
  deleted_at    DateTime?

  characters    Character[]

  @@map("animes")
}
model Character {
  id            Int                    @id @default(autoincrement()) @db.UnsignedInt
  anime_id      Int                    @db.UnsignedInt
  name          String                 @db.VarChar(255)
  description   String?                @db.Text
  currency_lock Boolean                @default(false)
  active        Boolean                @default(false)
  attr_hp       Int                    @default(0)
  attr_atk      Int                    @default(0)
  attr_def      Int                    @default(0)
  deleted_at    DateTime?

  anime         Anime                  @relation(fields: [anime_id], references: [id], onDelete: Restrict)

  @@index([anime_id], map: "idx_anime")
  @@map("characters")
}
model CharacterNames {
  id                  Int              @id @default(autoincrement()) @db.UnsignedInt
  character_name      String           @db.VarChar(255)

  @@map("characters_names")
}
model UserRestriction {
  id                Int @id @default(autoincrement()) @db.UnsignedInt
  user_id           Int @db.UnsignedInt
  moderator_id      Int @db.UnsignedInt
  restriction_type  RestrictionTypes
  reason            String @db.Text
  created_at        DateTime @default(now())
  expires_at        DateTime?
  revoked_at        DateTime?
  active            Boolean @default(true)

  user              User @relation("RestrictedUser", fields: [user_id], references: [id])
  moderator         User @relation("ModeratorUser", fields: [moderator_id], references: [id])

  @@map("user_restrictions")
}
model UserSession {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id       Int      @db.UnsignedInt
  session_token String   @unique @db.VarChar(255)
  expires_at    DateTime @db.DateTime
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user          User     @relation(fields: [user_id], references: [id])

  @@map("user_sessions")
}
model UserUnlocks {
  id          Int         @id @default(autoincrement()) @db.UnsignedInt
  characters  UserCharacters[]
  user_id     Int         @db.UnsignedInt
  unlock_type UnlockTypes
  unlock_key  String?     @db.VarChar(255)
  unlock_date DateTime    @default(now())

  user        User        @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "user_unlocks_user_id_fkey")
  @@map("user_unlocks")
}
model UserCharacters {
  id           Int          @id @default(autoincrement()) @db.UnsignedInt
  user_id      Int          @db.UnsignedInt
  character_id Int          @db.UnsignedInt
  was_default  Boolean
  unlocked_on  DateTime     @default(now())
  unlock_id    Int?         @db.UnsignedInt

  user         User         @relation(fields: [user_id], references: [id])
  unlock       UserUnlocks? @relation(fields: [unlock_id], references: [id])

  @@map("user_characters")
}
model User {
  id                      Int           @id @default(autoincrement()) @db.UnsignedInt
  username                String        @unique
  email                   String        @unique
  user_key                String        @db.VarChar(255)
  activation_key          String?       @db.VarChar(255)
  reset_password_key      String?       @db.VarChar(255)
  active                  Boolean       @default(false)
  currency                Int           @default(100)
  level                   Int           @default(1)
  created_at              DateTime      @db.DateTime
  activated_at            DateTime?     @db.DateTime
  avatar_url              String?       @db.VarChar(255)

  characters              UserCharacters[]
  user_power              UserPower     @default(Regular)
  session                 UserSession[]
  unlocks                 UserUnlocks[]
  restrictions            UserRestriction[] @relation("RestrictedUser")
  moderated_restrictions  UserRestriction[] @relation("ModeratorUser")

  @@index([email], map: "email")
  @@index([activation_key], map: "idx_activation")
  @@index([user_key], map: "idx_key")
  @@index([username], map: "idx_username")
  @@index([reset_password_key], map: "reset_password_key")
  @@map("users")
}

enum UserPower {
  Regular
  Moderator
  Admin
}

enum UnlockTypes {
  Character
  Equipment
  Skill
  Story
}

enum RestrictionTypes {
  BAN
  SUSPENSION
}
